cat > .env.example << 'EOF'
# Copy this to .env and fill in — .env is gitignored, never commit real keys.

# Default: shared Timescale Cloud instance (see README for the connection string)
DATABASE_URL=postgresql+asyncpg://tsdbadmin:PASSWORD@HOST.tsdb.cloud.timescale.com:PORT/tsdb

# Alternative: local Docker Postgres (see infra/docker/docker-compose.yml)
# DATABASE_URL=postgresql+asyncpg://compass:compass_dev_password@localhost:5432/compass

BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
EOF
